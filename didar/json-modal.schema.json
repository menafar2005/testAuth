{
  "schemaVersion": 1,
  "layout": "form",
  "title": {
    "fa": "تخصیص لید",
    "en": "Assign lead"
  },
  "description": {
    "fa": "معامله‌های انتخاب‌شده را به یک کارشناس تخصیص دهید.",
    "en": "Assign the selected deals to a sales rep."
  },
  "loadOnOpen": false,
  "sections": [
    {
      "id": "assignment",
      "title": {
        "fa": "تخصیص",
        "en": "Assignment"
      },
      "items": [
        {
          "type": "message",
          "text": {
            "fa": "فیلدهای ستاره‌دار الزامی هستند.",
            "en": "Fields marked with an asterisk are required."
          },
          "variant": "info"
        },
        {
          "type": "text",
          "key": "assignedUserId",
          "label": {
            "fa": "شناسه‌ی کارشناس",
            "en": "Rep user ID"
          },
          "placeholder": {
            "fa": "مثلاً 355de67e-b5fc-417b-9ff5-15c229f5f2eb",
            "en": "e.g. 355de67e-b5fc-417b-9ff5-15c229f5f2eb"
          },
          "required": true,
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "select",
          "key": "priority",
          "label": {
            "fa": "اولویت",
            "en": "Priority"
          },
          "required": true,
          "defaultValue": "normal",
          "options": [
            { "label": { "fa": "کم", "en": "Low" }, "value": "low" },
            { "label": { "fa": "عادی", "en": "Normal" }, "value": "normal" },
            { "label": { "fa": "زیاد", "en": "High" }, "value": "high" }
          ]
        },
        {
          "type": "radio",
          "key": "assignmentMode",
          "label": {
            "fa": "روش تخصیص",
            "en": "Assignment mode"
          },
          "defaultValue": "manual",
          "options": [
            { "label": { "fa": "دستی", "en": "Manual" }, "value": "manual" },
            { "label": { "fa": "چرخش نوبتی", "en": "Round-robin" }, "value": "round_robin" }
          ]
        },
        {
          "type": "number",
          "key": "score",
          "label": {
            "fa": "امتیاز لید",
            "en": "Lead score"
          },
          "helpText": {
            "fa": "عددی بین ۰ تا ۱۰۰",
            "en": "A number from 0 to 100"
          },
          "defaultValue": 50,
          "min": 0,
          "max": 100
        },
        {
          "type": "date",
          "key": "followUpDate",
          "label": {
            "fa": "تاریخ پیگیری",
            "en": "Follow-up date"
          }
        },
        {
          "type": "textarea",
          "key": "note",
          "label": {
            "fa": "توضیحات",
            "en": "Note"
          },
          "placeholder": {
            "fa": "توضیح کوتاه درباره‌ی این تخصیص",
            "en": "A short note about this assignment"
          },
          "maxLength": 1000
        },
        {
          "type": "checkbox",
          "key": "updateRoundRobinPointer",
          "label": {
            "fa": "نوبت چرخش روی این کارشناس ثبت شود",
            "en": "Move the rotation pointer to this rep"
          },
          "defaultValue": true
        },
        {
          "type": "divider"
        },
        {
          "type": "value",
          "key": "status",
          "label": {
            "fa": "وضعیت",
            "en": "Status"
          },
          "defaultValue": "New"
        },
        {
          "type": "link",
          "label": {
            "fa": "مشاهده وب‌سایت دیدار",
            "en": "Visit Didar website"
          },
          "url": "https://didar.me"
        }
      ]
    }
  ],
  "submit": {
    "label": {
      "fa": "ثبت تخصیص",
      "en": "Save assignment"
    },
    "closeOnSuccess": true,
    "successMessage": {
      "fa": "تخصیص ثبت شد.",
      "en": "Assignment saved."
    }
  }
}
